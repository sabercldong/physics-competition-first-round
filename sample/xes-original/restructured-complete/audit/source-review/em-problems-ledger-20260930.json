  "changes": [
    {
      "example": "19.11",
      "problem": "无限长线电荷的恒速积分缺少有限装置条件，强偏转结论过于绝对",
      "resolution": "补有限区间横向冲量、arctan偏转角、纵向动能变化须小的条件及线长/线径限制；删除强偏转必依赖瞄准距的断言。"
    },
    {
      "example": "20.2",
      "problem": "等量同号情形只给相同对称球结论",
      "resolution": "补一般导体即使等量，电势仍可不同，低电势者仍可能出现负电斑块。"
    },
    {
      "example": "20.11",
      "problem": "柱形电容答案符号与题图不一致",
      "resolution": "统一为内半径a、外半径b、长度h，推导与框式均对应题图。"
    },
    {
      "example": "22.11",
      "problem": "只给Hall电压大小，未明确上下端极性",
      "resolution": "采用原题右手x/y/z坐标，定义上表面减下表面电势，给出正载流子正号及负载流子反号。"
    },
    {
      "example": "24.7",
      "problem": "外接电感模型的固定几何假设未明示",
      "resolution": "明确忽略其余自感与电阻，外接电感不随棒位置变化。"
    },
    {
      "example": "24.12",
      "problem": "原扫描有限D被缩窄成无穷远端点",
      "resolution": "恢复有限CD=ell的反正切通式，无穷远保留为特例；题图和分析图均改有限D，补零长度、h=0及反向积分检验。"
    },
    {
      "example": "24.15",
      "problem": "“总边长2a”与图和电阻计算不一致",
      "resolution": "改为“外框边长2a”，每小边a与r的定义保持。"
    },
    {
      "example": "24.18",
      "problem": "题框含线元与位移向量的证明辅助图",
      "resolution": "新增仅两线圈及给定电流的题图；原双积分分析图移入解答，原标签保留。"
    },
    {
      "example": "24.21",
      "problem": "题图提前显示相速度和零场分界辅助线",
      "resolution": "题框仅保留装置、尺寸、速度和给定场函数；相速度/场分区图移入解答。"
    },
    {
      "example": "25.2",
      "problem": "装置图在题框外，频率条件未展开全部退化情况",
      "resolution": "装置图移入题框，图注不提前提示方法；解出频率平方，补无实根、分母零及两支匹配时任意频率为纯电阻的情况。"
    },
    {
      "example": "25.5",
      "problem": "题目依赖题框外前置电路图",
      "resolution": "原线圈-电容装置图移入题框，不重复插图。"
    },
    {
      "example": "26.1",
      "problem": "题干引用已经给出磁场方向与位移电流公式的分析图",
      "resolution": "新增只有极板边界、观察点和电场变化方向的题图；原安培环路及磁场分析图移入解答。"
    },
    {
      "example": "26.2",
      "problem": "峰值公式缺少偏振/波形条件",
      "resolution": "明确按单色线偏振平面波近似，保证峰值与平均能流的因子2适用。"
    },
    {
      "example": "26.3",
      "problem": "理想反射未明确是镜面反射",
      "resolution": "明确镜面反射，支持斜入射法向动量反转的推导。"
    },
    {
      "example": "26.4",
      "problem": "直接引用反射系数，边界求解步骤略去",
      "resolution": "补切向E、H连续方程，说明反射磁场负号，再解出反射/透射系数并核对能流。"
    }
  ],
